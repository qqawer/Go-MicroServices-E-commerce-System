{
  "settings": {"number_of_shards": 1, "number_of_replicas": 0},
  "mappings": {
    "_meta": {"lab": "grpctest-es-stage-1"},
    "dynamic": "strict",
    "properties": {
      "id": {"type": "integer"},
      "name": {
        "type": "text", "analyzer": "smartcn",
        "fields": {"raw": {"type": "keyword"}}
      },
      "brief": {"type": "text", "analyzer": "smartcn"},
      "category": {"type": "keyword"},
      "brand": {"type": "keyword"},
      "price_cents": {"type": "integer", "coerce": false},
      "on_sale": {"type": "boolean"},
      "inventory_ready": {"type": "boolean"}
    }
  }
}
