{
  "settings": {"number_of_shards": 1, "number_of_replicas": 0},
  "mappings": {
    "_meta": {"lab": "grpctest-goods-snapshot-v1"},
    "dynamic": "strict",
    "properties": {
      "id": {"type": "long"},
      "name": {"type": "text", "analyzer": "smartcn", "fields": {"raw": {"type": "keyword"}}},
      "brief": {"type": "text", "analyzer": "smartcn"},
      "category_id": {"type": "long"},
      "brand_id": {"type": "long"},
      "price_cents": {"type": "long", "coerce": false},
      "on_sale": {"type": "boolean"},
      "inventory_ready": {"type": "boolean"},
      "ship_free": {"type": "boolean"},
      "is_new": {"type": "boolean"},
      "is_hot": {"type": "boolean"}
    }
  }
}
